{
  "manifest_version": 3,
  "name": "青年心盾内容分析助手",
  "version": "0.1.0",
  "description": "基于当前页面 URL 生成内容风险分析结果的浏览器插件原型。",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "内容风险分析助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["anime.min.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
