# 复制本文件为 backend/.env 并填入你自己的值。.env 已被 .gitignore 排除，不会提交。
# 注意：main.py 里是 load_dotenv() 无参调用，按进程工作目录向上查找，
# 实测放在 backend/ 下（与 main.py 同级）才生效，放项目根目录不读。

# ── Anthropic 客户端（部分叙事分析等用）──
# 用中转就填中转地址，用官方 API 就把 BASE_URL 留空。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── OpenAI 兼容接口（六维精判、处置策略/引导话术生成）──
# 方案一：本地 ollama（推荐，数据不出本机、无需 key）
#   先 ollama pull qwen2.5:7b，并以 OLLAMA_NUM_PARALLEL=4 启动 ollama serve
NIHILISM_OPENAI_BASE_URL=http://localhost:11434/v1
NIHILISM_OPENAI_MODEL=qwen2.5:7b
NIHILISM_OPENAI_API_KEY=ollama
# 方案二：走云端 GPT-5.5，把上面三行注释掉、启用下面三行
# NIHILISM_OPENAI_BASE_URL=https://api.aicodewith.com/chatgpt/v1
# NIHILISM_OPENAI_MODEL=gpt-5.5
# NIHILISM_OPENAI_API_KEY=        # 也可放 ~/.codex/auth.json 的 OPENAI_API_KEY
NIHILISM_LLM_TIMEOUT=40

# ── MySQL 数据库 ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=youth_ideology

# ── 视频转写（whisper.cpp）──
# 不填则按 PATH 查找 whisper-cli / ffmpeg；模型必须手动下载，仓库不含（1.6GB）。
# Windows 用正斜杠或双反斜杠，例：C:/Users/admin/whisper-models/ggml-large-v3-turbo.bin
WHISPER_BIN=
WHISPER_MODEL=
FFMPEG_BIN=
FFPROBE_BIN=

# ── 六维研判性能 ──
# 窗口并发数；设 >1 时 ollama 必须带 OLLAMA_NUM_PARALLEL=4 启动，否则请求会排队
TRANSCRIPT_WINDOW_WORKERS=4
