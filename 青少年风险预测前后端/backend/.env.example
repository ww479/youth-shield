# 复制本文件为 .env 并填入你自己的值。.env 已被 .gitignore 排除，不会提交。

# ── Anthropic 客户端（部分叙事分析等用）──
# 用中转就填中转地址，用官方 API 就把 BASE_URL 留空。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── OpenAI 兼容接口（六维精判、处置策略/引导话术生成，默认走 GPT-5.5）──
# KEY 也可放在 ~/.codex/auth.json 的 OPENAI_API_KEY 字段，二选一。
NIHILISM_OPENAI_API_KEY=
NIHILISM_OPENAI_BASE_URL=
NIHILISM_OPENAI_MODEL=gpt-5.5
NIHILISM_LLM_TIMEOUT=40

# ── MySQL 数据库 ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=youth_ideology
